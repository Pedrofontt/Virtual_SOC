<group name="lab,">
  <rule id="100010" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)rundll32\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1438|1fffff)$</field>
    <description>LAB: LSASS access by rundll32 (T1003.001 simulation) - target $(win.eventdata.targetImage) source $(win.eventdata.sourceImage)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,sysmon_process_access,</group>
  </rule>

  <rule id="100020" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)(?:powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(?:encodedcommand|enco|enc|ec|en|e)\b\s+[\x22\x27]?[A-Za-z0-9+/]{12,}={0,2}</field>
    <description>LAB: PowerShell encoded command (T1059.001) - image $(win.eventdata.image)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>execution,sysmon_process_create,</group>
  </rule>

  <rule id="100029" level="8">
    <field name="Authentication.status" type="pcre2">^NT_STATUS_WRONG_PASSWORD$</field>
    <description>LAB: failed domain logon - $(Authentication.clientAccount)@$(Authentication.clientDomain) from $(Authentication.remoteAddress)</description>
    <group>authentication_failure,lab,identity_attack,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100030" level="12" frequency="3" timeframe="60">
    <if_matched_sid>100029</if_matched_sid>
    <same_field>Authentication.mappedAccount</same_field>
    <description>LAB: logon burst - 3+ failed logons in 60s for $(Authentication.mappedAccount)</description>
    <group>authentication_failure,lab,identity_attack,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100031" level="3">
    <field name="Authentication.status" type="pcre2">^NT_STATUS_OK$</field>
    <description>LAB: successful domain logon - $(Authentication.clientAccount)@$(Authentication.clientDomain) from $(Authentication.remoteAddress)</description>
    <group>authentication_success,lab,</group>
  </rule>

  <rule id="100032" level="12">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">sam\.ldb\.d/DC=CORP,DC=LAB\.ldb</field>
    <description>LAB: Active Directory database modified - $(file)</description>
    <group>fim,lab,identity_attack,</group>
    <mitre><id>T1565.001</id></mitre>
  </rule>

  <rule id="100033" level="12">
    <field name="KDC Authorization.serviceDescription" type="pcre2">MSSQLSvc</field>
    <description>LAB: Kerberoasting - TGS-REQ for $(KDC Authorization.serviceDescription) by $(KDC Authorization.account)</description>
    <group>credential_access,lab,identity_attack,</group>
    <mitre><id>T1558.003</id></mitre>
  </rule>

  <rule id="100034" level="12">
    <match>AS-REQ ERR_PREAUTH_REQUIRED.*victim[0-9]*@CORP</match>
    <description>LAB: AS-REP roasting attempt - pre-auth-less AS-REQ for a no-pre-auth account (UF_DONT_REQUIRE_PREAUTH)</description>
    <group>credential_access,lab,identity_attack,</group>
    <mitre><id>T1558.004</id></mitre>
  </rule>
  <rule id="100040" level="8">
    <field name="alert.signature_id">7000001</field>
    <description>LAB NDR: marker - lab-ndr-test User-Agent</description>
    <group>ndr,lab,</group>
  </rule>
  <rule id="100041" level="10">
    <field name="alert.signature_id">7000002</field>
    <description>LAB NDR: TCP port scan</description>
    <group>ndr,lab,discovery,</group>
    <mitre><id>T1046</id></mitre>
  </rule>
  <rule id="100042" level="12">
    <field name="alert.signature_id">7000003</field>
    <description>LAB NDR: beaconing to non-standard port</description>
    <group>ndr,lab,command_and_control,</group>
    <mitre><id>T1571</id></mitre>
  </rule>
  <rule id="100043" level="12">
    <field name="alert.signature_id">7000004</field>
    <description>LAB NDR: ICMP tunneling</description>
    <group>ndr,lab,exfiltration,</group>
    <mitre><id>T1095</id></mitre>
  </rule>
  <rule id="100044" level="12">
    <field name="alert.signature_id">7000005</field>
    <description>LAB NDR: DNS anomaly (tunneling)</description>
    <group>ndr,lab,exfiltration,</group>
    <mitre><id>T1071.004</id></mitre>
  </rule>
  <rule id="100045" level="12">
    <field name="alert.signature_id">7000006</field>
    <description>LAB NDR: SMB brute force</description>
    <group>ndr,lab,credential_access,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100046" level="10">
    <field name="alert.signature_id">7000007</field>
    <description>LAB NDR: cleartext FTP credentials</description>
    <group>ndr,lab,credential_access,</group>
    <mitre><id>T1040</id></mitre>
  </rule>
</group>