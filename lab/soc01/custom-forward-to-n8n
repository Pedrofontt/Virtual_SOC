#!/bin/bash
# Wazuh custom integration: forwards the rule-100047 alert JSON to n8n.
# argv: $1 = alert file path, $2 = api_key (unused), $3 = hook_url
ALERT_FILE="$1"
HOOK_URL="$3"
RESP="$(curl -s -w 'HTTP:%{http_code}' -X POST -H 'Content-Type: application/json' --data-binary @"$ALERT_FILE" "$HOOK_URL" 2>&1)"
echo "$(date -u +%FT%TZ) custom-forward-to-n8n: $RESP" >> /var/ossec/logs/integrations.log
