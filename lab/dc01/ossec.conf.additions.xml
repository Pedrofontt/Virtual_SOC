<!-- /var/ossec/etc/ossec.conf additions on DC01 (Task 4 Step 3) — inserted before </ossec_config> -->
<localfile>
  <log_format>json</log_format>
  <location>/var/log/samba/audit.json</location>
</localfile>
<localfile>
  <log_format>syslog</log_format>
  <location>/var/log/samba/log.samba</location>
</localfile>
<syscheck>
  <disabled>no</disabled>
  <!-- TDB writes are mmap/msync: mtime changes but inotify does NOT fire, so realtime
       alone never detects sam.ldb changes. Lower the scan frequency so the periodic
       checksum scan catches them (~60s latency). -->
  <frequency>60</frequency>
  <!-- The REAL write target is the domain partition inside sam.ldb.d, NOT the top-level
       sam.ldb stub (whose mtime never changes). -->
  <directories check_all="yes" realtime="yes">/var/lib/samba/private/sam.ldb.d</directories>
</syscheck>
